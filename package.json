{
  "name": "dsh-ledger-dock",
  "version": "0.1.0",
  "description": "DSH 右侧栏的记账本：记一笔（金额/分类/备注）、本月支出收入结余、按分类统计；数据全在本地，Agent 也能读写（ledger_panel 工具）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "ledger",
    "expense",
    "bookkeeping",
    "sidebar"
  ],
  "author": "lemonhall",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemonhall/dsh-ledger-dock.git"
  },
  "homepage": "https://github.com/lemonhall/dsh-ledger-dock#readme",
  "bugs": {
    "url": "https://github.com/lemonhall/dsh-ledger-dock/issues"
  },
  "meta": {
    "title": "记账本",
    "description": "右侧栏一个 tab：记一笔、本月结余、分类统计；本地存储，Agent 也能记账和查账。"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
